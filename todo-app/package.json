{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HEADER_IMAGE_DIR=./.tmp/header-image bun --bun --conditions=development ./node_modules/.bin/react-router dev",
    "start": "NODE_ENV=production bun run server.ts",
    "build": "bun --bun ./node_modules/.bin/react-router build",
    "typecheck": "bun --bun ./node_modules/.bin/react-router typegen && tsc"
  },
  "dependencies": {
    "cn": "^0.2.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "isbot": "^5.2.2",
    "tailwindcss": "^4.1.11",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
